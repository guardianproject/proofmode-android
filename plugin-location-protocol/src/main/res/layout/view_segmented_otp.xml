<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/otp_box_0"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/otp_digit_background">

            <TextView
                android:id="@+id/otp_digit_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/onboarding_gray"
                android:textSize="20sp" />

            <View
                android:id="@+id/otp_caret_0"
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@color/colorPrimary"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/otp_box_1"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/otp_digit_background">

            <TextView
                android:id="@+id/otp_digit_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/onboarding_gray"
                android:textSize="20sp" />

            <View
                android:id="@+id/otp_caret_1"
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@color/colorPrimary"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/otp_box_2"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/otp_digit_background">

            <TextView
                android:id="@+id/otp_digit_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/onboarding_gray"
                android:textSize="20sp" />

            <View
                android:id="@+id/otp_caret_2"
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@color/colorPrimary"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/otp_box_3"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/otp_digit_background">

            <TextView
                android:id="@+id/otp_digit_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/onboarding_gray"
                android:textSize="20sp" />

            <View
                android:id="@+id/otp_caret_3"
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@color/colorPrimary"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/otp_box_4"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/otp_digit_background">

            <TextView
                android:id="@+id/otp_digit_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/onboarding_gray"
                android:textSize="20sp" />

            <View
                android:id="@+id/otp_caret_4"
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@color/colorPrimary"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/otp_box_5"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:background="@drawable/otp_digit_background">

            <TextView
                android:id="@+id/otp_digit_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/onboarding_gray"
                android:textSize="20sp" />

            <View
                android:id="@+id/otp_caret_5"
                android:layout_width="2dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@color/colorPrimary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <org.witness.proofmode.plugins.lp.wallet.auth.components.OtpCodeEditText
        android:id="@+id/et_otp_code"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autofillHints="smsOTPCode"
        android:background="@null"
        android:contentDescription="Verification code"
        android:cursorVisible="false"
        android:imeOptions="actionDone"
        android:importantForAutofill="yes"
        android:inputType="number"
        android:maxLines="1"
        android:textColor="@android:color/transparent" />
</FrameLayout>
