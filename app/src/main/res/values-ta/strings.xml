    <string name="onboarding_intro_title">ஊடகம் மற்றும் உண்மை, சரிபார்க்கப்பட்டது.</string>
    <string name="onboarding_intro_content">ப்ரூஃப்மோட் உங்கள் மீடியாவை மிகவும் நம்பகமானதாக மாற்றும் தகவலைப் பிடிக்கிறது.</string>
    <string name="onboarding_step1_title">ப்ரூப்மோட் கேமரா மூலம் ஆதாரத்தைப் பெறுவது எளிது!</string>
    <string name="onboarding_step1_content">ஆதாரத்தை உருவாக்கவும் சேமிக்கவும் ப்ரூஃப்மோட் பின்னணியில் செயல்படுகிறது. நீங்கள் சிறப்பு எதுவும் செய்ய வேண்டியதில்லை!</string>
    <string name="onboarding_step2_title">நீங்கள் ஒரு புகைப்படம் அல்லது வீடியோவை எடுத்தவுடன், அதை ப்ரூஃப்மோட் முகப்புத் திரையில் கண்டறியவும்.</string>
    <string name="onboarding_step2_content">புகைப்படம் அல்லது வீடியோவைத் திறந்து, பகிர்வு ஐகானைத் தட்டி, \'Share Proof\' என்பதைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="onboarding_step3">படி 3</string>
    <string name="onboarding_step3_title">நீங்கள் அனுப்புவதற்கு முன், எந்த அளவிலான ஆதாரத்தைப் பகிர வேண்டும் என்பதைத் தேர்வுசெய்க.</string>
    <string name="onboarding_step3_content">நீங்கள் எப்போதும் கட்டுப்பாட்டில் இருக்கிறீர்கள். அடிப்படை பங்குகள் உங்கள் ஊடகங்கள் இருப்பதை நிரூபிக்க குறைந்தபட்ச செய்தி. கைப்பற்றப்பட்ட அனைத்தையும் வலுவான பகிர்கிறது.</string>
    <string name="onboarding_step4">படி 4</string>
    <string name="onboarding_step4_title">அதை எவ்வாறு அனுப்புவது என்பதைத் தேர்வுசெய்க.</string>
    <string name="onboarding_step4_content">மின்னஞ்சல் முதல் வாட்ச்அப் போன்ற செய்தியிடல் சேவைகள் வரை பல வழிகளைப் பகிரலாம்!</string>
    <string name="onboarding_privacy_title">ப்ரூஃப்மோட் ஆதாரத்தை உருவாக்க உங்கள் மொபைலில் பல சென்சார்களை செயல்படுத்துகிறது.</string>
    <string name="onboarding_privacy_content">எங்களின் டேட்டா லெசெண்டில் என்ன ப்ரூஃப் மோட் கேப்சர் உள்ளது என்பதைப் பற்றி அறிக.</string>
    <string name="onboarding_privacy_subtitle">உங்கள் தனியுரிமையைப் பற்றி நாங்கள் கவலைப்படுகிறோம்</string>
    <string name="onboarding_privacy_info">ப்ரூஃப்மோட் உங்கள் மொபைலின் அடையாளத்தை முன்னிருப்பாகப் பிடிக்கும். இது உங்களுக்கு வசதியாக இல்லை என்றால், அதை அணைக்க அமைப்புகளுக்குச் செல்லவும்.</string>
