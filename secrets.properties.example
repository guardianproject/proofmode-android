# Copy to secrets.properties (gitignored) or add these keys to local.properties.
# Values are loaded at build time: secrets.defaults.properties → secrets.properties → local.properties

# Privy embedded wallet (https://dashboard.privy.io/)
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_CLIENT_ID=your-privy-app-client-id

# ZeroDev gas sponsorship (https://dashboard.zerodev.app/)
# Required for Path A (sponsored UserOp). Create a project, enable a gas policy for Sepolia,
# then paste the project UUID below. Bundler + paymaster URLs are derived automatically per chain.
ZERODEV_PROJECT_ID=your-zerodev-project-uuid

# Optional legacy overrides (Base mainnet only; leave blank to use derived URLs):
# ZERODEV_PROJECT_ID_BASE=
# ZERODEV_BUNDLER_URL_BASE=https://rpc.zerodev.app/api/v3/your-zerodev-project-uuid/chain/8453
# ZERODEV_PAYMASTER_URL_BASE=https://rpc.zerodev.app/api/v3/your-zerodev-project-uuid/chain/8453
